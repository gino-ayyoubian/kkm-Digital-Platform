# ==============================================================================
# KKM INTERNATIONAL GROUP - ENTERPRISE ENVIRONMENT & SECRETS CONFIGURATION
# ==============================================================================
# NOTE: In production (Google Cloud Run / Vercel), do NOT commit real secrets here.
# Deploy variables to your Cloud Secrets Vault (e.g. Google Secret Manager or Vercel Vault).
# When NODE_ENV=production, the server performs strict validation and will abort startup
# if required production vault secrets are missing or placeholder.
# ==============================================================================

# 1. CORE SERVER SECRETS (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# High-entropy cryptographic seed for JWT tokens (Min 48 chars).
# In production, injected from Cloud Run Secret Manager or Vercel Secrets.
JWT_SECRET=

# Internal Server API Key for inter-service communication and SCADA endpoints.
KKM_INTERNAL_API_KEY=

# Ingested Corporate Credentials in JSON Array format.
# Structure: [{"uid":"...","email":"...","username":"...","password":"..."}]
# Allows provisioning customized enterprise passwords into the hashed credential map.
KKM_CORPORATE_AUTH_JSON=

# 2. AI & INTELLIGENCE INTEGRATION (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# Google Gemini API Key for autonomous telemetry analysis and bilingual advisors.
GEMINI_API_KEY=

# 3. CLIENT-SIDE VARIABLES (PRE-FIXED WITH VITE_)
# ------------------------------------------------------------------------------
# Google Maps Platform API key (if custom map styling/geocoding is enabled)
VITE_GOOGLE_MAPS_API_KEY=

# Analytics & Web Vitals Telemetry Identifier
VITE_ANALYTICS_ID=

# 4. OBSERVABILITY & TELEMETRY
# ------------------------------------------------------------------------------
# Sentry DSN for backend Node.js crash reporting
SENTRY_DSN=

# Sentry DSN for frontend React exception tracking
VITE_SENTRY_DSN=
