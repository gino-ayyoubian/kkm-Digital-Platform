rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // System Metrics
    match /systemMetrics/{metricId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /sustainabilityAlerts/{alertId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /userPreferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /meetingBookings/{bookingId} {
      // Anyone can create a meeting booking (public form)
      allow create: if true;
      // Admins and authenticated staff can read and manage
      allow read, update, delete: if isSignedIn();
    }
  
    match /leads/{leadId} {
      // Public inquiry forms can submit leads
      allow create: if true;
      // Authenticated portal users can read and update leads
      allow read, update: if isSignedIn();
      allow delete: if isAdmin();
    }
    
    match /contentArticles/{articleId} {
      allow read: if resource.data.status == 'Publish' || isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /claims/{claimId} {
      // Claims are publicly readable for transparency and evidence governance
      allow read: if true;
      // Only admins and signed-in technical governance staff can modify claims
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}
